# =========================
# API Settings
# =========================
API_TITLE="Mental Health Detection API"
API_VERSION="1.0.0"
API_DESCRIPTION="Unified API for Depression, Emotion, and Sentiment Detection"
API_HOST="0.0.0.0"
API_PORT=8000

# =========================
# CORS
# =========================
ALLOWED_ORIGINS="*"  # Comma-separated list if multiple origins

# =========================
# Database
# =========================
DATABASE_URL="sqlite+aiosqlite:///./mental_health_api.db"
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname
   
# =========================
# MLflow Settings
# =========================
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="mental_health_api"

# =========================
# Depression Detection Model
# =========================
DEPRESSION_MODEL_NAME="ziadashraf98765/roberta-depression-detection-lora-merged"
DEPRESSION_MODEL_VERSION="1.0"

# =========================
# Emotion Detection Model
# =========================
EMOTION_MODEL_NAME="CNN_EmotionDetection"
EMOTION_MODEL_VERSION="1"
EMOTION_MODEL_STAGE=""
EMOTION_CONFIG_PATH="../Emotion_detection/src/config/inference_config.yaml"

# =========================
# Sentiment Analysis Model
# =========================
SENTIMENT_MODEL_PATH="../Sentiment_analysis/models"
SENTIMENT_VECTORIZER_PATH="../Sentiment_analysis/models/vectoriser.pkl"

# =========================
# Rate Limiting
# =========================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# =========================
# Logging
# =========================
LOG_LEVEL="INFO"
LOG_FILE="logs/api.log"

# =========================
# Security
# =========================
API_KEY_ENABLED=False
API_KEY=""
